$name: "Radiophone (Zeppelin)"
$desc: 
	'''
	Small handheld device used for short-range radio communication.

	This one is tuned for frequencies typically used by zeppelins.
	'''
$tags: []

body:
{
	@shape.line:
	{
		material: device
		miss_chance: 0.543
		flags: none
		tags: none
		
		layer: entity, solid, item, conductive, magnetic, ignore_melee, no_overlapped_placement
		mask: world
		exclude: none
		
		mass: 7.800
		radius: 0.500
		friction: 0.720
		elasticity: 0.640
		
		fall_damage_mult: 1.850
		// cog_offset: [0.000, 0.1875]
		
		a: [0.000, -0.125]
		b: [0.000, 0.250]
		offset: [0.000, 0.000]
	}
}

control:
{

}

health:
{
	max: 3400.000
}

holdable:
{
	offset: [0.375, 0.125]
	priority: 1.000
	flags: storable
}

animated.renderer:
{
	sprite:
	{
		texture: phone.00
	}
	scale: [0.875, 0.875]
	z: 10.000
}

transform:
{

}

interactable:
{
	flags: interact_on_pickup
	window_size: [384, 344]
	window_size_misc: [48, 0]
}

phone:
{
	h_coalition: energon
}

